# TelegramBase Phase 3 Test Bot configuration
# Copy to .env and fill in BOT_TOKEN, or set via environment variables.

# ============================================
# Bot (required)
# ============================================
BOT_TOKEN=""
BOT_MODE="update_direct"
BOT_API_URL="https://api.telegram.org"
BOT_API_URL_FILE="https://api.telegram.org"

# ============================================
# Plugins (set by bot.php to TestBot/Plugin/)
# ============================================
# PLUGINS_DIR is overridden by bot.php — don't set here.

# ============================================
# Polling
# ============================================
POLLING_LIMIT=100
POLLING_TIMEOUT=10
POLLING_RESTART_INTERVAL=0

# ============================================
# Cache (override per-scenario)
# ============================================
CACHE_DRIVER="array"
CACHE_PREFIX="tgbase_test_"

# ============================================
# Database (override per-scenario)
# ============================================
DATABASE_ENABLE=false

# ============================================
# Queue (override per-scenario)
# ============================================
QUEUE_SAVE_TYPE="json"

# ============================================
# Retry
# ============================================
RETRY_ENABLED=true
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=2

# ============================================
# Logging
# ============================================
LOG_ENABLED=true
LOG_LEVEL=debug
LOG_DIR="./runtime/logs"

# ============================================
# Plugin cache (disabled for fresh test plugins)
# ============================================
PLUGIN_CACHE_ENABLED=false
