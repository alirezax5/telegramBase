# ============================================
# Application
# ============================================
APP_DEBUG=false
DATA_DIR="AppData"

# ============================================
# Bot
# ============================================
BOT_TOKEN=""
BOT_MODE="update_direct" #update_direct , update_queue,webhook_direct,webhook_queue,cronjob_update,cronjob_queue
BOT_API_URL="https://api.telegram.org"
BOT_API_URL_FILE="https://api.telegram.org"
BOT_WEBHOOK_URL=""
BOT_WEBHOOK_SECRET=""              # long random string (openssl rand -hex 32).
                                   # When WEBHOOK_CHECK_IP=false (proxies/CDN), this secret
                                   # is the only inbound-auth layer — keep it strong.
WEBHOOK_CHECK_IP=true              # verify sender IP is Telegram (disable behind Cloudflare/proxies)

ALLOWED_UPDATES="all"

# Multiple bots in one process: "name1:token1,name2:token2" (split on the
# FIRST colon only — tokens themselves contain a colon). "main" is reserved.
# See docs/multi-bot.md.
BOT_EXTRA_BOTS=""

# Set to 1 to let DB-only CLI commands (make:migration, plugins:list, …)
# run without a valid BOT_TOKEN.
TGBASE_SKIP_BOT_VALIDATION=0

POLLING_LIMIT=100
POLLING_TIMEOUT=30
POLLING_STATE_FILE="lastupdate.txt"
# Self-restart after N batches to keep memory bounded (expects a process
# supervisor to restart). Set to 0 to disable self-restart.
POLLING_RESTART_INTERVAL=100

# ============================================
# CronJob
# ============================================
CRON_WORKER=10
CRON_MAX_TIME=50

# ============================================
# Plugins
# ============================================
PLUGINS_DIR="/Plugin/"
PLUGIN_CACHE_ENABLED=true
PLUGIN_CACHE_TTL=300
PLUGINS_RELOAD_INTERVAL=600

# ============================================
# Language
# ============================================
# LANG_DRIVER must match your translation file format. The shipped files
# (Language/fa.php, Language/fa/main.php) are PHP arrays → keep "php".
# With the "json" default and .php files, every lookup silently falls
# back to the key name (see docs/i18n.md).
LANG_DRIVER="php"
DEFAULT_LANG="fa"
LANG_DIR="/Language"
LANG_CACHE_TTL=60

# ============================================
# Buttons
# ============================================
BUTTONS_DIR="/Button"
BUTTONS_FILE="btn.php"
BUTTONS_CACHE_TTL=60
BUTTONS_CACHE_ENABLED=true         # false = always re-read definitions from files

# ============================================
# Queue
# ============================================
QUEUE_SAVE_TYPE="json" # json, redis,rabbitmq,memcached

# Bounded queue: when QUEUE_MAX_SIZE is reached (and > 0), new pushes are
# rejected and logged instead of growing without limit.
QUEUE_MAX_SIZE=0
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY=2

QUEUE_REDIS_KEY="bot_updates"
QUEUE_MEMCACHED_KEY="bot_updates"
RABBITMQ_QUEUE="bot_updates"

# ============================================
# Cache
# ============================================
# Drivers: array | file | redis | memcached.
# Unavailable drivers (e.g. missing ext-memcached) fall back to array
# with a logged warning. See docs/caching.md.
CACHE_DRIVER="array"
CACHE_PREFIX="tgbase_"
# Default TTL (seconds) for put()/remember() calls without an explicit TTL.
CACHE_TTL=300

# File Cache Driver — directory for CACHE_DRIVER="file".
# Leave empty to use the system temp dir (/tmp/tgbase-cache).
CACHE_PATH=""

# ============================================
# Session
# ============================================
SESSION_TTL=3600
SESSION_PREFIX="tgbase:session:"

# ============================================
# Scheduler
# ============================================
SCHEDULER_LOCK_TABLE="task_locks"
SCHEDULER_LOCK_TTL=300
# Task file loaded by bin/scheduler.php (absolute or project-relative path).
SCHEDULE_FILE=""

# ============================================
# Retry Queue (Error Handler)
# ============================================
RETRY_ENABLED=true
RETRY_QUEUE_DRIVER="json"          # json, redis
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=2
RETRY_MAX_SIZE=1000
RETRY_REDIS_KEY="bot_retry_queue"

# ============================================
# Database
# ============================================
# Set to true only if you have a DB configured (Database/Connections.php).
# Defaults to false — leave false if you only need the framework without Eloquent.
DATABASE_ENABLE=false

DB_DRIVER="mysql"                  # any PDO driver (sqlite for local dev)
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_DATABASE=""
DB_USERNAME=""
DB_PASSWORD=""
DB_FILE=""

# ============================================
# Redis
# ============================================
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DATABASE=0                   # logical DB index (cache + connection layer)
REDIS_TIMEOUT=60

# ============================================
# RabbitMQ
# ============================================
RABBITMQ_HOST="127.0.0.1"
RABBITMQ_PORT=5672
RABBITMQ_USER="admin"
RABBITMQ_PASSWORD=""
RABBITMQ_VHOST="/"

# ============================================
# Memcached
# ============================================
MEMCACHED_HOST="127.0.0.1"
MEMCACHED_PORT=11211

MEMCACHED_USERNAME=""
MEMCACHED_PASSWORD=""

# ============================================
# Logging
# ============================================
LOG_ENABLED=true
LOG_DIR="./logs"
LOG_FILE="log.txt"
LOG_LEVEL="debug"

# ============================================
# Admins
# ============================================
# Comma-separated Telegram user ids for AdminGuardMiddleware.
ADMINS_WHITELIST=""
